{
  "$comment": "UTNM alignment + long-section object styles (16 Sep 2026), from claude/utnm-alignment-profile-style-spec.md. Apply with civil3d_style library_apply {path: 'C:/Dev/Civil3D-mcp/styles/utnm/alignment-profile-styles.json'} (upsert). Markers first. Marker sizes with sizeType DrawingScale are in METRES of paper (0.002 = 2 mm). Known API limit: MarkerStyle.Orientation = OrientToObject is rejected by Civil 3D 2026 ('enum value 0 not valid') - after applying, open 'UTNM IP' in Toolspace and set Orientation to 'Orient to object' by hand so the tick follows the alignment.",
  "styles": [
    {
      "family": "marker",
      "name": "UTNM IP",
      "description": "UTNM IP / geometry point marker: circle + tick, 2 mm. Set Orientation to 'Orient to object' in the UI (API rejects it).",
      "display": {
        "plan": { "Marker": { "visible": true, "color": "ByLayer", "layer": "0" } },
        "model": { "Marker": { "visible": false } },
        "profile": { "Marker": { "visible": false } },
        "section": { "Marker": { "visible": false } }
      },
      "properties": {
        "markerType": "UseCustomMarker",
        "customMarkerStyle": "CustomMarkerVLine",
        "customMarkerSuperimposeStyle": "Circle",
        "sizeType": "DrawingScale",
        "markerSize": 0.002,
        "orientation": "OrientToWCS"
      }
    },
    {
      "family": "marker",
      "name": "UTNM PVI",
      "description": "UTNM profile VIP marker: circle 2 mm",
      "display": {
        "plan": { "Marker": { "visible": false } },
