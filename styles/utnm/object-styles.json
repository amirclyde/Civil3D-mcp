{
  "$comment": "UTNM object-style library, phase 1 (15 Sep 2026). Apply with civil3d_style library_apply {path: 'C:/Dev/Civil3D-mcp/styles/utnm/object-styles.json'} (upsert; ifExists defaults to update). Order matters: markers before the styles that reference them.",
  "styles": [
    {
      "family": "marker",
      "name": "UTNM PI",
      "description": "UTNM alignment PI marker",
      "display": {
        "plan": {
          "Marker": {
            "visible": true,
            "color": 2,
            "layer": "C-ROAD-STAN-UTNM",
            "layerColor": 2
          }
        },
        "model": {
          "Marker": {
            "visible": false
          }
        }
      },
      "properties": {
        "markerType": "UseCustomMarker",
        "customMarkerStyle": "CustomMarkerX",
        "customMarkerSuperimposeStyle": "Circle",
        "sizeType": "AbsoluteUnits",
        "markerSize": 2,
        "orientation": "OrientToWCS"
      }
    },
    {
      "family": "surface",
      "name": "UTNM Contours 0.5m and 2.5m",
      "description": "UTNM design surface - 0.5 m minor / 2.5 m major contours, border on",
      "display": {
        "plan": {
          "MajorContour": {
            "visible": true,
            "color": 1,
            "layer": "C-TOPO-MAJR-UTNM",
            "layerColor": 1,
            "lineweight": 0.35
          },
          "MinorContour": {
            "visible": true,
            "color": 9,
            "layer": "C-TOPO-MINR-UTNM",
            "layerColor": 9,
            "lineweight": 0.18
          },
          "Boundary": {
            "visible": true,
            "color": 3
          },
          "Triangles": {
            "visible": false
          },
          "Points": {
            "visible": false
          }
        },
        "model": {
          "Triangles": {
            "visible": true,
            "color": 8
          }
        }
      },
      "surface": {
        "contours": {
          "majorInterval": 2.5,
          "minorInterval": 0.5,
          "smooth": true,
          "smoothingType": "AddVertices",
          "smoothingFactor": 5,
          "depressions": false
        },
        "boundary": {
          "exterior": true,
          "interior": true
        }
      }
    },
    {
      "family": "surface",
